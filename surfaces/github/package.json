{
  "name": "@sluice-dev/github",
  "version": "0.2.0",
  "description": "Sluice GitHub surfaces: the \"Sluice Gate\" GitHub App (webhook server) and the GitHub Action.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sluice-gate-app": "./bin/sluice-gate-app.js"
  },
  "exports": {
    ".": {
      "@sluice-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "action",
    "app.yml"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODumpling/sluice.git",
    "directory": "surfaces/github"
  },
  "homepage": "https://github.com/ODumpling/sluice#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@sluice-dev/github-api": "workspace:*",
    "@sluice-dev/plugin-gate": "workspace:*",
    "@sluice-dev/sandbox": "workspace:*",
    "@sluice-dev/config": "workspace:*"
  }
}
