{
  "name": "@sluice-dev/cli",
  "version": "0.1.0",
  "description": "Sluice CLI: nothing merges until the checks open the gate.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sluice": "./bin/sluice.js"
  },
  "exports": {
    ".": {
      "@sluice-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODumpling/sluice.git",
    "directory": "surfaces/cli"
  },
  "homepage": "https://github.com/ODumpling/sluice#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@sluice-dev/config": "workspace:*",
    "@sluice-dev/plugin-api": "workspace:*",
    "@sluice-dev/plugin-hello": "workspace:*",
    "commander": "^15.1.0",
    "@sluice-dev/sandbox": "workspace:*",
    "@sluice-dev/evidence": "workspace:*",
    "@sluice-dev/plugin-gate": "workspace:*",
    "@sluice-dev/web": "workspace:*",
    "@sluice-dev/plugin-bench": "workspace:*",
    "@sluice-dev/plugin-rules": "workspace:*",
    "@sluice-dev/policy": "workspace:*",
    "@sluice-dev/work": "workspace:*",
    "@sluice-dev/plugin-inbox": "workspace:*",
    "@sluice-dev/plugin-leases": "workspace:*",
    "@sluice-dev/plugin-campaign": "workspace:*"
  }
}
