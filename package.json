{
  "name": "sluice-monorepo",
  "private": true,
  "description": "Sluice: nothing merges until the checks open the gate.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./core/**\" --filter \"./plugins/**\" --filter \"./surfaces/**\" run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:all": "vitest run",
    "sluice": "node surfaces/cli/bin/sluice.js",
    "demo": "node scripts/demo.mjs",
    "docs:gen": "node scripts/gen-docs.mjs",
    "docs:build": "pnpm docs:gen && vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sluice-dev/cli": "workspace:*",
    "@sluice-dev/config": "workspace:*",
    "@sluice-dev/evidence": "workspace:*",
    "@sluice-dev/fakes": "workspace:*",
    "@sluice-dev/github": "workspace:*",
    "@sluice-dev/github-api": "workspace:*",
    "@sluice-dev/lang": "workspace:*",
    "@sluice-dev/mcp": "workspace:*",
    "@sluice-dev/plugin-bench": "workspace:*",
    "@sluice-dev/plugin-campaign": "workspace:*",
    "@sluice-dev/plugin-gate": "workspace:*",
    "@sluice-dev/plugin-inbox": "workspace:*",
    "@sluice-dev/plugin-leases": "workspace:*",
    "@sluice-dev/plugin-rules": "workspace:*",
    "@sluice-dev/policy": "workspace:*",
    "@sluice-dev/sandbox": "workspace:*",
    "@sluice-dev/web": "workspace:*",
    "@sluice-dev/work": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  }
}
