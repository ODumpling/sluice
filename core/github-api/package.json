{
  "name": "@sluice-dev/github-api",
  "version": "0.2.0",
  "description": "Minimal GitHub REST client for Sluice: check runs, PRs, contents, App JWT + installation tokens, webhook signatures.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@sluice-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODumpling/sluice.git",
    "directory": "core/github-api"
  },
  "homepage": "https://github.com/ODumpling/sluice#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
