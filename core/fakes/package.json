    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "stripe": "^23.1.0"
