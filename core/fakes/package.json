  "description": "Stateful, contract-validated fakes (Stripe, GitHub, S3) generated from OpenAPI + recorded traffic, with drift detection.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@sluice-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODumpling/sluice.git",
